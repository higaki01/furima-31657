<%= render "shared/second-header"%>
<%= form_with model: @card, url: users_cards_path, id: 'card-registration', class: 'registration-main', local: true do |f| %>
  <div class='form-wrap'>
    <div class='form-header'>
      <h1 class='form-header-text'>クレジットカード情報入力</h1>
    </div>
    <%= render partial: 'shared/error_messages', locals: { model: f.object, name: 'all_messages' } %>

    <div class = 'on-registration-js hidden'>
      <%# カード情報の入力 %>
      <div class="form-group">
        <div class='form-text-wrap'>
          <label class="form-text">カード情報</label>
          <span class="indispensable">必須</span>
        </div>
        <%= f.text_field :card_number, class:"input-default", id:"card-number", placeholder:"カード番号(半角英数字)", maxlength:"16" %>
        <div class='available-card'>
          <%= image_tag 'card-visa.gif', class: 'card-logo'%>
          <%= image_tag 'card-mastercard.gif', class: 'card-logo'%>
          <%= image_tag 'card-jcb.gif', class: 'card-logo'%>
          <%= image_tag 'card-amex.gif', class: 'card-logo'%>
        </div>
      </div>

      <div class="form-group">
        <div class='form-text-wrap'>
          <label class="form-text">有効期限</label>
          <span class="indispensable">必須</span>
        </div>
        <div class='input-expiration-date-wrap'>
          <%= f.select :card_exp_month, 1..12, {include_blank: "---"}, class: "input-expiration-date", id: "card-exp-month" %>
          <p>月</p>
          <%= f.select :card_exp_year, 20..25, {include_blank: "---"}, class: "input-expiration-date", id: "card-exp-year" %>
          <p>年</p>
        </div>
      </div>

      <div class="form-group">
        <div class='form-text-wrap'>
          <label class="form-text">セキュリティコード</label>
          <span class="indispensable">必須</span>
        </div>
        <%= f.text_field :card_cvc, class:"input-default", id:"card-cvc", placeholder:"カード背面4桁もしくは3桁の番号", maxlength:"4" %>
      </div>
      <%# /カード情報の入力 %>
    </div>

    <div class = 'registration-select-wrap'>
      <div class = 'form-group'>
        <div class = 'registration-btn google'>
          <%= check_box_tag :select_registration, true, false, class: 'icon' %>
          <span>入力する</span>
        </div>
      </div>
    </div>

    <div class = 'off-registration-js'>
      <div class = 'form-group'>
        <%= link_to users_addresses_path, type: 'button', class: 'registration-btn gray' do %>
          <i class = 'fas fa-angle-double-left webfont left'></i> 
          <span>戻る</span>
        <% end %>
      </div>
      <div class = 'form-group'>
        <%= link_to '入力せず完了', users_completion_path, method: :post, type: 'button', class: 'registration-btn red' %>
      </div>
    </div>

    <div class = 'on-registration-js hidden'>  
     <div class = 'form-group'>
        <%= link_to users_addresses_path, type: 'button', class: 'registration-btn gray' do %>
          <i class = 'fas fa-angle-double-left webfont left'></i> 
          <span>戻る</span>
        <% end %>
      </div> 
      <div class = 'form-group'>
        <%= f.submit "入力して完了", class: 'registration-btn red' %>
      </div>
    </div>
  </div>
<% end %>
<%= render "shared/second-footer"%>