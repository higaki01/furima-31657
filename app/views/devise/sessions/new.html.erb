<%= render "shared/second-header"%>

<%= form_with model: @user, url: user_session_path, method: :post, local: true, class: 'registration-main', local: true do |f| %>
  <div class='form-wrap'>

    <div class='login-flash-message'>
      <%= flash[:notice] %>
      <%= flash[:alert] %>
      <%= flash[:recaptcha_error] %>
    </div>

    <div class = 'login-header'> 
      <div class = 'form-group'>
        <span>アカウントをお持ちでない方はこちら</span>
        <%= link_to users_registration_path, type: 'button', class: 'registration-btn blue' do %>
          <span>新規会員登録</span>
        <% end %>
      </div>
    </div>

    <div class = 'sns-registration'>
      <div class = 'form-group'>
        <%= link_to user_google_oauth2_omniauth_authorize_path, type: 'button', class: 'registration-btn google' do %>
          <%= image_tag 'google-icon.svg', class: 'icon'%>
          <span>Googleでログイン</span>
        <% end %>
      </div>

      <div class = 'form-group'>
        <%= link_to user_facebook_omniauth_authorize_path, type: 'button', class: 'registration-btn facebook' do %>
          <%= image_tag 'f_logo_RGB-White_1024.png', class: 'icon'%>
          <span>Facebookでログイン</span>
        <% end %>
      </div>
    </div>
    
    <div class = 'form-group'>
      <%= f.email_field :email, class:"input-default", id:"email", placeholder:'メールアドレス', autofocus: true %>
    </div>
    <div class = 'form-group'>
      <%= f.password_field :password, class:"input-default", id:"password", placeholder: "パスワード" %>
    </div>

    <div class = 'form-group'>
      <%= recaptcha_tags %>
    </div>

    <div class = 'form-group'>
      <%= f.submit "ログイン" ,class:"registration-btn red" %>
    </div>
  </div>
<% end %>

<%= render "shared/second-footer"%>